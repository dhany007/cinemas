# Obtain a personal development key from https://www.omdbapi.com/apikey.aspx.
# Docker Compose loads a local .env file automatically; never commit that file.
OMDB_API_KEY=

# Optional local seed settings. The defaults are appropriate only for local development.
# SEED_ADMIN_EMAIL=admin@cinemas.local
# SEED_ADMIN_PASSWORD=local-admin-password-change-me
# SEED_ADMIN_DISPLAY_NAME=Local Administrator
